<UserControl
    x:Class="OpenClaw.ChatControl.AssistantMessageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenClaw.ChatControl">

    <Border x:Name="BubbleBorder"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="12,12,12,2"
            Padding="12,8,12,8"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" MinHeight="32">
        <StackPanel Spacing="4">
            <!-- Reasoning block (collapsible, shown when model provides thinking) -->
            <local:ReasoningBlock x:Name="ReasoningPanel" Visibility="Collapsed"/>

            <!-- Thinking indicator -->
            <StackPanel x:Name="ThinkingPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="16" Height="16"/>
                <TextBlock Text="Thinking..." FontStyle="Italic" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Tool call cards -->
            <ItemsRepeater x:Name="ToolCallsList" Visibility="Collapsed">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="0"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:ToolCallInfo">
                        <local:ToolCallCard DataContext="{x:Bind}"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Streaming text (plain TextBlock, shown during streaming) -->
            <TextBlock x:Name="StreamingText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Visibility="Collapsed"/>

            <!-- Rendered markdown (shown after completion) -->
            <ContentPresenter x:Name="RenderedContent" Visibility="Collapsed"/>

            <!-- Metadata footer with action icons (sender · time · tokens · model + copy/speak) -->
            <Grid x:Name="FooterGrid" Visibility="Collapsed" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MetadataFooterText" Grid.Column="0" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>

                <!-- Copy + Read Aloud action icons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                    <Button x:Name="CopyButton" Click="OnCopyClick"
                            Width="26" Height="26" Padding="0"
                            Background="Transparent" BorderThickness="0">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Copy"/>
                        </ToolTipService.ToolTip>
                        <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Button>
                    <Button x:Name="ReadAloudButton" Click="OnReadAloudClick"
                            Width="26" Height="26" Padding="0"
                            Background="Transparent" BorderThickness="0">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Read aloud"/>
                        </ToolTipService.ToolTip>
                        <FontIcon x:Name="ReadAloudIcon" Glyph="&#xE767;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Error/aborted indicator -->
            <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                <FontIcon Glyph="&#xE7BA;" FontSize="12"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                <TextBlock x:Name="ErrorText" FontSize="12"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
