<UserControl
    x:Class="OpenClaw.ChatControl.ToolCallCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="6" Padding="8,4,8,4" Margin="0,2,0,2">
        <StackPanel Spacing="2">
            <!-- Header row: icon + name + status -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIcon" Text="⏳" FontSize="12"/>
                    <TextBlock x:Name="ToolNameText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Expand/collapse toggle (only when result available) -->
                <Button x:Name="ExpandButton" Grid.Column="2"
                        Click="OnExpandClick"
                        Width="20" Height="20" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Visibility="Collapsed">
                    <FontIcon x:Name="ExpandIcon" Glyph="&#xE76C;" FontSize="10"/>
                </Button>

                <!-- Spinner for running state -->
                <ProgressRing x:Name="RunningSpinner" Grid.Column="2"
                              IsActive="True" Width="14" Height="14"
                              Visibility="Collapsed"/>
            </Grid>

            <!-- Result summary (collapsed by default) -->
            <TextBlock x:Name="ResultText" FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Visibility="Collapsed" MaxLines="4" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</UserControl>
