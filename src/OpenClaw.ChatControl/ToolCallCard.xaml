<UserControl
    x:Class="OpenClaw.ChatControl.ToolCallCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}"
            CornerRadius="8" Padding="10,6,10,6" Margin="0,2,0,2"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">
        <StackPanel Spacing="2">
            <!-- Header row: icon + name + status -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIcon" Text="⏳" FontSize="12"/>
                    <TextBlock x:Name="ToolNameText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Expand args toggle -->
                <Button x:Name="ExpandArgsButton" Grid.Column="2"
                        Click="OnExpandArgsClick"
                        Width="22" Height="22" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Visibility="Collapsed">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Show arguments"/>
                    </ToolTipService.ToolTip>
                    <FontIcon x:Name="ExpandArgsIcon" Glyph="&#xE76C;" FontSize="10"/>
                </Button>

                <!-- Expand output toggle -->
                <Button x:Name="ExpandOutputButton" Grid.Column="3"
                        Click="OnExpandOutputClick"
                        Width="22" Height="22" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Visibility="Collapsed">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Show output"/>
                    </ToolTipService.ToolTip>
                    <FontIcon x:Name="ExpandOutputIcon" Glyph="&#xE7B8;" FontSize="10"/>
                </Button>

                <!-- Spinner for running state -->
                <ProgressRing x:Name="RunningSpinner" Grid.Column="3"
                              IsActive="True" Width="14" Height="14"
                              Visibility="Collapsed"/>
            </Grid>

            <!-- Args section (collapsed by default) -->
            <Border x:Name="ArgsSection" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4" Padding="8,4,8,4" Margin="0,2,0,0">
                <TextBlock x:Name="ArgsText" FontSize="11" TextWrapping="Wrap"
                           FontFamily="Cascadia Code, Cascadia Mono, Consolas, monospace"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           MaxLines="10" TextTrimming="CharacterEllipsis"
                           IsTextSelectionEnabled="True"/>
            </Border>

            <!-- Output section (collapsed by default) -->
            <Border x:Name="OutputSection" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4" Padding="8,4,8,4" Margin="0,2,0,0">
                <TextBlock x:Name="OutputText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           MaxLines="10" TextTrimming="CharacterEllipsis"
                           IsTextSelectionEnabled="True"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
