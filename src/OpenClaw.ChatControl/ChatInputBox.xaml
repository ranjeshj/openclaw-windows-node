<UserControl
    x:Class="OpenClaw.ChatControl.ChatInputBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8,12,8">
        <StackPanel Spacing="8">
            <!-- Input row -->
            <TextBox x:Name="InputTextBox"
                     PlaceholderText="Message Assistant (Enter to send)"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxHeight="120"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="OnInputKeyDown"
                     TextChanged="OnTextChanged"
                     BorderThickness="1"
                     CornerRadius="8"/>

            <!-- Bottom toolbar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Footer info (left) -->
                <TextBlock x:Name="FooterText" Grid.Column="0"
                           Text="OpenClaw Native Chat"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                <!-- Action buttons (right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <!-- Attach (not wired — red border) -->
                    <Button Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="Red">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Attach file (not wired)"/>
                        </ToolTipService.ToolTip>
                        <FontIcon Glyph="&#xE723;" FontSize="13"/>
                    </Button>

                    <!-- Mic (not wired — red border) -->
                    <Button Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="Red">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Voice input (not wired)"/>
                        </ToolTipService.ToolTip>
                        <FontIcon Glyph="&#xE720;" FontSize="13"/>
                    </Button>

                    <!-- More (not wired — red border) -->
                    <Button Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="Red">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="More options (not wired)"/>
                        </ToolTipService.ToolTip>
                        <FontIcon Glyph="&#xE712;" FontSize="13"/>
                    </Button>

                    <!-- Send button -->
                    <Button x:Name="SendButton" Click="OnSendClick"
                            Width="32" Height="32" Padding="0" IsEnabled="False"
                            Background="Transparent" BorderThickness="0">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Send (Enter)"/>
                        </ToolTipService.ToolTip>
                        <FontIcon Glyph="&#xE724;" FontSize="14"
                                  Foreground="{ThemeResource SystemAccentColor}"/>
                    </Button>

                    <!-- Stop button (visible when running) -->
                    <Button x:Name="StopButton" Click="OnStopClick"
                            Width="32" Height="32" Padding="0" Visibility="Collapsed">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Stop generating"/>
                        </ToolTipService.ToolTip>
                        <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
