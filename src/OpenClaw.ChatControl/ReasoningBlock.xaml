<UserControl
    x:Class="OpenClaw.ChatControl.ReasoningBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}"
            CornerRadius="6" Padding="10,6,10,6" Margin="0,2,0,4">
        <StackPanel Spacing="2">
            <!-- Header: clickable to expand/collapse -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="💭" FontSize="12"/>
                    <TextBlock Text="Reasoning" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontStyle="Italic"/>
                </StackPanel>

                <Button x:Name="ToggleButton" Grid.Column="2"
                        Click="OnToggleClick"
                        Width="22" Height="22" Padding="0"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon x:Name="ToggleIcon" Glyph="&#xE76C;" FontSize="10"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Button>
            </Grid>

            <!-- Collapsed preview -->
            <TextBlock x:Name="PreviewText" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontStyle="Italic" MaxLines="1" TextTrimming="CharacterEllipsis"
                       Visibility="Visible"/>

            <!-- Expanded full content -->
            <TextBlock x:Name="FullText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontStyle="Italic" IsTextSelectionEnabled="True"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
