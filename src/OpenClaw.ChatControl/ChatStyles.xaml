<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ChatStyles.xaml — All visual styling for the chat control.
        Swap this resource dictionary for a different look (flat cards, dark theme, etc.)
    -->

    <!-- Bubble geometry -->
    <x:Double x:Key="ChatBubbleMaxWidth">600</x:Double>
    <x:Double x:Key="ChatBubbleMinHeight">32</x:Double>
    <CornerRadius x:Key="ChatBubbleCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ChatUserBubbleCornerRadius">12,12,2,12</CornerRadius>
    <CornerRadius x:Key="ChatAssistantBubbleCornerRadius">12,12,12,2</CornerRadius>
    <Thickness x:Key="ChatBubblePadding">12,8,12,8</Thickness>
    <Thickness x:Key="ChatMessageMargin">0,4,0,4</Thickness>

    <!-- Code block -->
    <FontFamily x:Key="ChatCodeFontFamily">Cascadia Code, Cascadia Mono, Consolas, monospace</FontFamily>
    <x:Double x:Key="ChatCodeFontSize">13</x:Double>

    <!-- Input bar -->
    <x:Double x:Key="ChatInputMaxHeight">120</x:Double>
    <Thickness x:Key="ChatInputPadding">12,8,12,8</Thickness>

    <!-- Spacing -->
    <x:Double x:Key="ChatPanelPadding">16</x:Double>
    <x:Double x:Key="ChatMessageSpacing">8</x:Double>

</ResourceDictionary>
