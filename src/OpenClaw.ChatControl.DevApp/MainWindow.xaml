<Window
    x:Class="OpenClaw.ChatControl.DevApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chat="using:OpenClaw.ChatControl"
    Title="OpenClaw Chat Control — Dev">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Chat panel -->
        <chat:ChatPanel x:Name="ChatControl" Grid.Column="0"/>

        <!-- Dev controls sidebar -->
        <Border Grid.Column="1" Width="220"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1,0,0,0"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="Dev Controls" FontWeight="SemiBold" FontSize="14"/>

                <Button Content="Load History" Click="OnLoadHistory" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Simulate Response:" FontSize="12" Margin="0,8,0,0"
                           Foreground="{ThemeResource TextFillColorSecondary}"/>
                <Button Content="Short response" Click="OnShortResponse" HorizontalAlignment="Stretch"/>
                <Button Content="Markdown response" Click="OnMarkdownResponse" HorizontalAlignment="Stretch"/>
                <Button Content="Code block response" Click="OnCodeResponse" HorizontalAlignment="Stretch"/>
                <Button Content="Long response" Click="OnLongResponse" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Error Scenarios:" FontSize="12" Margin="0,8,0,0"
                           Foreground="{ThemeResource TextFillColorSecondary}"/>
                <Button Content="Send error" Click="OnSendError" HorizontalAlignment="Stretch"/>
                <Button Content="Stream error" Click="OnStreamError" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Settings:" FontSize="12" Margin="0,8,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Stream delay: 50ms" FontSize="12" x:Name="DelayLabel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
